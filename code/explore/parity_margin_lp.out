rho_crit = max rho with (rho on sieve positions, 1/2 on lambda positions) in hull of E-free sets

== 1. DHL[k,m+1] (all (m+1)-subsets); expect t* = m/k, threshold theta*M_k > 2m
DHL[2,2]                                     k= 2 |L|=0 rho_crit=1/2    cert=True parity-blocked=True  need theta*M_k > 2.0000 -> impossible for theta<=1 (M_k upper bound 1.386)
    dual inequality y = {0: '1/2', 1: '1/2'} 
DHL[3,2]                                     k= 3 |L|=0 rho_crit=1/3    cert=True parity-blocked=False need theta*M_k > 2.0000 -> impossible for theta<=1 (M_k upper bound 1.648)
    dual inequality y = {0: '1/3', 1: '1/3', 2: '1/3'} 
DHL[4,2]                                     k= 4 |L|=0 rho_crit=1/4    cert=True parity-blocked=False need theta*M_k > 2.0000 -> impossible for theta<=1 (M_k upper bound 1.848)
    dual inequality y = {0: '1/4', 1: '1/4', 2: '1/4', 3: '1/4'} 
DHL[5,2]                                     k= 5 |L|=0 rho_crit=1/5    cert=True parity-blocked=False need theta*M_k > 2.0000 -> YES at theta=1 (M_k >= 2.0041)
    dual inequality y = {0: '1/5', 1: '1/5', 2: '1/5', 3: '1/5', 4: '1/5'} 
DHL[4,3]                                     k= 4 |L|=0 rho_crit=1/2    cert=True parity-blocked=True  need theta*M_k > 4.0000 -> impossible for theta<=1 (M_k upper bound 1.848)
    dual inequality y = {0: '1/4', 1: '1/4', 2: '1/4', 3: '1/4'} 
DHL[5,3]                                     k= 5 |L|=0 rho_crit=2/5    cert=True parity-blocked=False need theta*M_k > 4.0000 -> impossible for theta<=1 (M_k upper bound 2.012)
    dual inequality y = {0: '1/5', 1: '1/5', 2: '1/5', 3: '1/5', 4: '1/5'} 
DHL[6,3]                                     k= 6 |L|=0 rho_crit=1/3    cert=True parity-blocked=False need theta*M_k > 4.0000 -> impossible for theta<=1 (M_k upper bound 2.150)
    dual inequality y = {0: '1/6', 1: '1/6', 2: '1/6', 3: '1/6', 4: '1/6', 5: '1/6'} 
DHL[6,4]                                     k= 6 |L|=0 rho_crit=1/2    cert=True parity-blocked=True  need theta*M_k > 6.0000 -> impossible for theta<=1 (M_k upper bound 2.150)
    dual inequality y = {0: '1/6', 1: '1/6', 2: '1/6', 3: '1/6', 4: '1/6', 5: '1/6'} 
DHL[7,4]                                     k= 7 |L|=0 rho_crit=3/7    cert=True parity-blocked=False need theta*M_k > 6.0000 -> impossible for theta<=1 (M_k upper bound 2.270)
    dual inequality y = {0: '1/7', 1: '1/7', 2: '1/7', 3: '1/7', 4: '1/7', 5: '1/7', 6: '1/7'} 
DHL[8,4]                                     k= 8 |L|=0 rho_crit=3/8    cert=True parity-blocked=False need theta*M_k > 6.0000 -> impossible for theta<=1 (M_k upper bound 2.377)
